/* ============================================================
   ২) স্মার্ট লজিক (সার্চ ও ট্যাব)
   ============================================================ */
const $ = id => document.getElementById(id);
let currentCategory = MENU[0]; // ডিফল্ট ক্যাটাগরি

// ট্যাব তৈরি করা
const tabsEl = $("tabs");
MENU.forEach((cat, i) => {
  const b = document.createElement("button");
  b.className = "tab" + (i === 0 ? " active" : "");
  b.textContent = cat.category;
  b.dataset.index = i;
  b.onclick = () => {
    // সার্চ ক্লিয়ার করা
    $("searchInput").value = ""; 
    
    document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
    b.classList.add("active");
    currentCategory = cat;
    renderMenu(cat.items);
    b.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
  };
  tabsEl.appendChild(b);
});

// মেনু রেন্ডার ফাংশন
function renderMenu(items) {
  const menu = $("menu");
  menu.innerHTML = "";
  
  if (items.length === 0) {
    menu.innerHTML = `<div class="empty-state"><h3>কোনো খাবার পাওয়া যায়নি!</h3><p>অন্য কিছু লিখে সার্চ করুন।</p></div>`;
    return;
  }

  items.forEach((item, index) => {
    const card = document.createElement("article");
    card.className = "item";
    // অ্যানিমেশন ডিলে তৈরি (সিরিয়ালি লোড হওয়ার জন্য)
    card.style.animationDelay = `${index * 0.05}s`;
    
    let imgHTML = item.image 
      ? `<img class="item-img" src="${item.image}" alt="${item.name}" loading="lazy" />`
      : `<div class="item-placeholder"><span>🍽️</span>ছবি যুক্ত করুন</div>`;

    card.innerHTML = `
      ${imgHTML}
      <div class="item-info">
        <h2>${item.name}</h2>
        <span class="price-tag">৳ ${item.price}</span>
      </div>
    `;
    menu.appendChild(card);
  });
}

// স্মার্ট সার্চ ফাংশন
function handleSearch() {
  const query = $("searchInput").value.toLowerCase().trim();
  
  if (query === "") {
    // সার্চ খালি থাকলে আগের ক্যাটাগরি দেখাবে
    document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
    tabsEl.children[currentCategory ? MENU.indexOf(currentCategory) : 0].classList.add("active");
    renderMenu(currentCategory.items);
    return;
  }

  // সব ক্যাটাগরি থেকে খাবার খোঁজা
  const allItems = MENU.flatMap(cat => cat.items);
  const filtered = allItems.filter(item => item.name.toLowerCase().includes(query));
  
  // ট্যাব ডি-অ্যাক্টিভ করা (যেহেতু এটি গ্লোবাল সার্চ)
  document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
  
  renderMenu(filtered);
}

// প্রথম ক্যাটাগরি লোড
renderMenu(MENU[0].items);
</script>
