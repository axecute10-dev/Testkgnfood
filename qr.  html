<style>
/* ============================================================
   KGN ব্র্যান্ড কালার ও মডার্ন ভ্যারিয়েবল
   ============================================================ */
:root {
  --brand:      #D3181C;   /* মূল লাল রঙ */
  --brand-dark: #9e1013;   
  --black:      #111111;   
  --bg:         #f4f6f9;   /* আধুনিক হালকা ধূসর-নীল ব্যাকগ্রাউন্ড */
  --card:       #ffffff;
  --text:       #2d3748;
  --muted:      #718096;
  --line:       #e2e8f0;
  --radius:     16px;
  --shadow:     0 4px 15px rgba(0,0,0,0.05);
  --shadow-hover: 0 8px 25px rgba(211,24,28,0.15);
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
body {
  font-family: 'Hind Siliguri', system-ui, sans-serif;
  background: var(--bg); color: var(--text); line-height: 1.5;
  padding-bottom: 80px;
}
img { display: block; max-width: 100%; }

/* ---------- মডার্ন হেডার ---------- */
header {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: #fff; text-align: center; padding: 30px 20px 20px;
  border-radius: 0 0 30px 30px;
  box-shadow: 0 4px 20px rgba(211,24,28,0.3);
  position: relative;
  overflow: hidden;
}
/* হেডারে হালকা গ্লো ইফেক্ট */
header::before {
  content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  pointer-events: none;
}
header .logo {
  height: 90px; width: auto; margin: 0 auto 12px;
  border-radius: 50%; background: #fff; padding: 4px;
  box-shadow: 0 8px 16px rgba(0,0,0,0.2);
  position: relative; z-index: 1;
}
header .logo-fallback {
  font-size: 32px; font-weight: 700; letter-spacing: 2px;
  margin-bottom: 5px; color: #fff; text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}
header h1 { font-size: 24px; font-weight: 700; position: relative; z-index: 1; }
header .tagline {
  font-size: 13px; color: rgba(255,255,255,0.9);
  margin-top: 4px; font-weight: 500; letter-spacing: 3px;
  text-transform: uppercase; position: relative; z-index: 1;
}

/* ---------- স্মার্ট সার্চ বার ---------- */
.search-container {
  padding: 15px 20px;
  margin-top: -20px;
  position: relative;
  z-index: 10;
  max-width: 650px;
  margin-left: auto;
  margin-right: auto;
}
.search-box {
  display: flex; align-items: center;
  background: var(--card); border-radius: 999px;
  padding: 10px 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.08);
  border: 1px solid var(--line);
}
.search-box svg { width: 20px; height: 20px; fill: var(--muted); margin-right: 10px; }
.search-box input {
  border: none; outline: none; width: 100%;
  font-family: inherit; font-size: 15px; color: var(--text);
  background: transparent;
}
.search-box input::placeholder { color: #a0aec0; }

/* ---------- গ্লাস-ইফেক্ট ক্যাটাগরি ট্যাব ---------- */
nav {
  position: sticky; top: 0; z-index: 20;
  display: flex; gap: 10px; overflow-x: auto;
  padding: 12px 20px;
  background: rgba(244, 246, 249, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(0,0,0,0.05);
  scrollbar-width: none;
  max-width: 650px;
  margin: 0 auto;
}
nav::-webkit-scrollbar { display: none; }
.tab {
  flex: 0 0 auto;
  padding: 8px 20px; border-radius: 999px;
  border: 1px solid var(--line); background: var(--card);
  color: var(--muted); font-size: 14.5px; font-family: inherit;
  white-space: nowrap; cursor: pointer; font-weight: 600;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.tab.active {
  background: var(--brand); color: #fff; border-color: var(--brand);
  box-shadow: 0 4px 12px rgba(211,24,28,0.3);
  transform: translateY(-2px);
}

/* ---------- মেনু কার্ড ---------- */
main {
  padding: 15px 20px; display: flex; flex-direction: column; gap: 15px;
  max-width: 650px; margin: 0 auto;
}
.item {
  display: flex; gap: 15px; align-items: center;
  background: var(--card); border-radius: var(--radius);
  padding: 12px; box-shadow: var(--shadow);
  border: 1px solid rgba(0,0,0,0.02);
  transition: transform 0.2s, box-shadow 0.2s;
  animation: slideUp 0.4s ease-out forwards;
  opacity: 0; transform: translateY(10px);
}
@keyframes slideUp {
  to { opacity: 1; transform: translateY(0); }
}
.item:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); }

.item-img {
  width: 100px; height: 100px; flex: 0 0 100px;
  border-radius: 12px; object-fit: cover; background: #f7fafc;
}
.item-placeholder {
  width: 100px; height: 100px; flex: 0 0 100px;
  border-radius: 12px; background: #f7fafc;
  border: 2px dashed #cbd5e0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #a0aec0; font-size: 10px; text-align: center;
}
.item-placeholder span { font-size: 28px; margin-bottom: 4px; }

.item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.item-info h2 { font-size: 17px; font-weight: 700; color: var(--black); line-height: 1.3; }
.price-tag {
  display: inline-block; margin-top: 8px;
  background: rgba(211, 24, 28, 0.08);
  color: var(--brand); padding: 4px 12px;
  border-radius: 8px; font-weight: 700; font-size: 15px;
  align-self: flex-start;
}

/* ---------- ফ্লোটিং অ্যাকশন বাটন (FAB) ---------- */
.fab-whatsapp {
  position: fixed; bottom: 25px; right: 25px;
  width: 60px; height: 60px;
  background: #25D366; color: #fff;
  border-radius: 50%; display: grid; place-items: center;
  box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
  z-index: 50; transition: transform 0.2s;
  text-decoration: none;
}
.fab-whatsapp:active { transform: scale(0.9); }
.fab-whatsapp svg { width: 32px; height: 32px; fill: currentColor; }

/* ---------- ফুটার ---------- */
footer {
  margin-top: 30px; padding: 30px 20px 50px;
  text-align: center; background: var(--black); color: #fff;
  border-radius: 30px 30px 0 0;
}
footer .wifi { font-size: 14px; margin-bottom: 8px; color: #cbd5e0; }
footer .addr { font-size: 13px; color: #a0aec0; line-height: 1.6; margin-bottom: 15px; }

/* ---------- এম্পটি স্টেট ---------- */
.empty-state {
  text-align: center; padding: 40px 20px; color: var(--muted);
}
.empty-state h3 { font-size: 18px; margin-bottom: 8px; }
